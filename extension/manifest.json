{
  "manifest_version": 3,
  "name": "BioPrint Behavioral Auth Demo",
  "version": "2.0.0",
  "description": "On-device behavioral biometric login gate with Mahalanobis matching and anti-bot signals.",
  "action": { "default_title": "BioPrint", "default_popup": "index.html" },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
